# Auto detect text files and perform normalization
* text=auto eol=lf

# Source code - force LF line endings
*.gd text eol=lf
*.cs text eol=lf
*.gdextension text eol=lf

# Project config
project.godot text eol=lf
*.cfg text eol=lf
*.tres text eol=lf
*.tscn text eol=lf

# Data files
*.json text eol=lf
*.tres text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files - do not normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.tres binary
